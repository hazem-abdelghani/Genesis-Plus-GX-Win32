  LTEXT           "Slot 1 (empty)", IDC_STATEMGR_LABEL_BASE + 1, 74, 54, 60, 10, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 2, 140, 8, 60, 45, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 2 (empty)", IDC_STATEMGR_LABEL_BASE + 2, 140, 54, 60, 10, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 3, 206, 8, 60, 45, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 3 (empty)", IDC_STATEMGR_LABEL_BASE + 3, 206, 54, 60, 10, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 4, 272, 8, 60, 45, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 4 (empty)", IDC_STATEMGR_LABEL_BASE + 4, 272, 54, 60, 10, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 5, 8, 71, 60, 45, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 5 (empty)", IDC_STATEMGR_LABEL_BASE + 5, 8, 117, 60, 10, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 6, 74, 71, 60, 45, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 6 (empty)", IDC_STATEMGR_LABEL_BASE + 6, 74, 117, 60, 10, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 7, 140, 71, 60, 45, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 7 (empty)", IDC_STATEMGR_LABEL_BASE + 7, 140, 117, 60, 10, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 8, 206, 71, 60, 45, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 8 (empty)", IDC_STATEMGR_LABEL_BASE + 8, 206, 117, 60, 10, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 9, 272, 71, 60, 45, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 9 (empty)", IDC_STATEMGR_LABEL_BASE + 9, 272, 117, 60, 10, SS_CENTER
  LTEXT           "Left-click a slot to load it. Right-click for options.", IDC_STATIC, 8, 128, 324, 10
  DEFPUSHBUTTON   "Close", IDCANCEL, 282, 140, 50, 16
END

IDD_INPUT DIALOGEX 0, 0, 320, 234
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configure Player"
FONT 8, "MS Shell Dlg"
BEGIN
  LTEXT           "Gamepad:", IDC_STATIC, 10, 12, 34, 9
  COMBOBOX        IDC_INPUT_DEVICE, 48, 9, 100, 90,
                  CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT           "Pad type:", IDC_STATIC, 226, 12, 34, 9
  COMBOBOX        IDC_INPUT_PADTYPE, 226, 26, 84, 90,
                  CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT           "Keyboard", IDC_STATIC, 74, 28, 60, 9
  LTEXT           "Controller", IDC_STATIC, 139, 28, 71, 9
  LTEXT           "Up", IDC_INPUT_LABEL_BASE+0, 10, 42, 60, 9
  LTEXT           "Down", IDC_INPUT_LABEL_BASE+1, 10, 52, 60, 9
  LTEXT           "Left", IDC_INPUT_LABEL_BASE+2, 10, 62, 60, 9
  LTEXT           "Right", IDC_INPUT_LABEL_BASE+3, 10, 72, 60, 9
  LTEXT           "A", IDC_INPUT_LABEL_BASE+4, 10, 82, 60, 9
  LTEXT           "B", IDC_INPUT_LABEL_BASE+5, 10, 92, 60, 9
  LTEXT           "C", IDC_INPUT_LABEL_BASE+6, 10, 102, 60, 9
  LTEXT           "X", IDC_INPUT_LABEL_BASE+7, 10, 112, 60, 9
  LTEXT           "Y", IDC_INPUT_LABEL_BASE+8, 10, 122, 60, 9
  LTEXT           "Z", IDC_INPUT_LABEL_BASE+9, 10, 132, 60, 9
  LTEXT           "Start", IDC_INPUT_LABEL_BASE+10, 10, 142, 60, 9
  LTEXT           "Mode", IDC_INPUT_LABEL_BASE+11, 10, 152, 60, 9
  LTEXT           "Fast forward", IDC_INPUT_LABEL_BASE+12, 10, 162, 60, 9
  LTEXT           "Rewind", IDC_INPUT_LABEL_BASE+13, 10, 172, 60, 9
  LISTBOX         IDC_INPUT_LIST, 74, 40, 136, 140,
                  LBS_NOTIFY | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP | WS_BORDER
  PUSHBUTTON      "Assign...", IDC_INPUT_ASSIGN, 226, 60, 84, 16
  PUSHBUTTON      "Auto Assign...", IDC_INPUT_AUTOASSIGN, 226, 80, 84, 16
  PUSHBUTTON      "Clear", IDC_INPUT_CLEAR, 226, 100, 84, 16
  PUSHBUTTON      "Restore defaults", IDC_INPUT_DEFAULTS, 226, 120, 84, 16
  LTEXT           "Pick a button, choose Assign, then press the key you want.",
                  IDC_INPUT_HINT, 10, 186, 300, 18
  DEFPUSHBUTTON   "Save", IDOK, 208, 210, 50, 16
  PUSHBUTTON      "Cancel", IDCANCEL, 262, 210, 48, 16
END

