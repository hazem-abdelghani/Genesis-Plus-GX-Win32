IDD_STATEMGR_LARGE DIALOGEX 0, 0, 340, 158
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Manage Save States"
FONT 12, "MS Shell Dlg"
BEGIN
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 0, 8, 8, 60, 45, BS_BITMAP | BS_NOTIFY
